# Copy this file to `.env` (never commit `.env`) and fill in your own values.

# --- Required: your own Supabase project (Settings -> API) ---
# Use the anon / public key only. NEVER put a service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Optional: Google Sheets sync (Apps Script web-app URL) ---
# VITE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# Link shown under "View Source Sheet" in Quick Actions
# VITE_SOURCE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# --- Optional: door-unlock webhook (feature is disabled when unset) ---
# VITE_DOOR_UNLOCK_URL=https://your-door-endpoint.example.com/unlock

# --- Optional: local development ---
# VITE_DEV_PORT=3000
# Folder for the volunteer "portal" demo data (defaults to ./demo-data/volunteers)
# PORTAL_DATA_DIR=./demo-data/volunteers
