{
  "name": "food-distribution-tracker",
  "version": "2.2.1",
  "description": "Real-time food distribution tracker for volunteer-run community food groups (placeholder data)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "vite build --config vite.config.production.js",
    "preview": "vite preview",
    "lint": "eslint --config .eslintrc.json \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:supabase": "npx tsx src/__tests__/integration/supabaseTest.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.55.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.56.0",
    "@tailwindcss/vite": "^4.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/ui": "^3.2.4",
    "audit-ci": "^6.6.1",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.17",
    "dotenv": "^17.2.1",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.2",
    "sass": "^1.93.2",
    "shadcn": "^3.5.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.5",
    "typescript": "^5.1.6",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "food-distribution",
    "volunteer-coordination",
    "real-time-tracking"
  ],
  "author": "Community contributors",
  "license": "MIT"
}
